{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "shell-timeout": "180000",
        "bundle-name": "com.test.battery.static",
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsPowerMgrBatteryStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },{
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "hidumper -s 3301 -a -t"
            ]
        }
    ]
}